// ==============================================================================
// Power BI DAX Measure: ACWA DGA 3D Geospatial Intelligence Map Visual
// Visual Used: "HTML Content" (by Daniel Marsh-Patrick, AppSource Certified)
// Hosted on GitHub: https://zubairanwar499-bi.github.io/Custom_Map/
// ==============================================================================

3D_DGA_Custom_Map = 
// 1. GitHub Pages deployment link
VAR _BaseURL = "https://zubairanwar499-bi.github.io/Custom_Map/"

// 2. Build dynamic JSON from currently filtered Coordinates and Tested transformers
VAR _PlantsJson = 
    "[" & 
    CONCATENATEX(
        FILTER(
            SUMMARIZE(
                'Coordinates',
                'Coordinates'[Plant Name],
                'Coordinates'[Country],
                'Coordinates'[Longitude],
                'Coordinates'[Latitude],
                "TestedCount", [Tested]
            ),
            NOT(ISBLANK('Coordinates'[Plant Name])) && [TestedCount] > 0
        ),
        "{" &
            """id"": """ & SUBSTITUTE('Coordinates'[Plant Name], """", "\""") & """," &
            """name"": """ & SUBSTITUTE('Coordinates'[Plant Name], """", "\""") & """," &
            """country"": """ & 'Coordinates'[Country] & """," &
            // Note: In Coordinates table, Longitude column stores Lat and Latitude stores Lon:
            """lat"": " & 'Coordinates'[Longitude] & "," &
            """lon"": " & 'Coordinates'[Latitude] & "," &
            """val"": " & [TestedCount] & "," &
            """status"": ""Operational""," &
            """type"": ""Power Substation""," &
            """kpi_label"": ""Tested Transformers""," &
            """kpi_formatted"": """ & FORMAT([TestedCount], "#,##0") & " Tested""" &
        "}",
        ","
    ) & 
    "]"

// 3. URL Encode JSON safely for iframe source
VAR _EncodedJson = 
    SUBSTITUTE(
        SUBSTITUTE(
            SUBSTITUTE(
                SUBSTITUTE(
                    SUBSTITUTE(_PlantsJson, " ", "%20"),
                    """", "%22"
                ),
                "{", "%7B"
            ),
            "}", "%7D"
        ),
        ":", "%3A"
    )

// 4. Return responsive HTML iframe
VAR _IframeHtml = 
    "<iframe src=""" & _BaseURL & "?theme=cyber&mode=globe&data=" & "{%22sites%22:" & _EncodedJson & "}" & """ " &
    "style=""width:100%; height:100%; min-height:580px; border:none; border-radius:12px; background:transparent; overflow:hidden;"" " &
    "allow=""fullscreen""></iframe>"

RETURN 
    _IframeHtml
